# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional override (default is already set in code: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=10080

# CORS (comma-separated origins for Stitch / local frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# App
DEBUG=true
SEED_DEFAULT_ADMIN=false
DATABASE_PATH=LocalInsights.db

# Pipeline budget guards (Groq free-tier friendly)
MAX_GAPS=5
MAX_WEB_SEARCHES=3
