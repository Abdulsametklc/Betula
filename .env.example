# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional override (default is already set in code: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=10080

# CORS (comma-separated public origins in production)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# App
DEBUG=true
SEED_DEFAULT_ADMIN=false
DATABASE_PATH=LocalInsights.db
# Production / Docker volume examples:
# DATABASE_PATH=/data/LocalInsights.db
# UPLOADS_ROOT=/data/uploads
# VECTORSTORE_ROOT=/data/vectorstore

# Pipeline budget guards (Groq free-tier friendly)
MAX_GAPS=5
MAX_WEB_SEARCHES=3

# SMTP — email/password change + forgot-password activation codes
# Leave empty in local DEBUG to print codes to console / return dev_code
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false

SECURITY_CODE_TTL_MINUTES=10
SECURITY_CODE_COOLDOWN_SECONDS=60

# Public URL (OAuth callback base). Local default:
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_BASE_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
# Authorization callback URL: {PUBLIC_BASE_URL}/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
